        "    str\n",
        "        Bullet-point summary from LLaMA 3.\n",
        "    \"\"\"\n",
        "    prompt_text = SUMMARIZE_PROMPT.format(topic=topic)\n",
        "    response    = llm.invoke(prompt_text)\n",
        "    return response.content\n",
        "\n",
        "\n",
        "print(\" Tool 2 (Summariser) ready.\")"
      ]
