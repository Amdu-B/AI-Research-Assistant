      "source": [
        "\"\"\"\n",
        "ReAct Agent Construction\n",
        "=========================\n",
        "ReAct (Reasoning + Acting) is a prompting strategy where the LLM\n",
        "alternates between:\n",
        "  - Thought  : chain-of-thought reasoning about what to do next\n",
        "  - Action   : selecting and calling a tool with arguments\n",
        "  - Observation : reading the tool's output\n",
        "...until it produces a Final Answer.\n",
        "\n",
        "The agent prompt is pulled from LangChain Hub (hwchase17/react),\n",
        "a community-maintained, battle-tested ReAct prompt template.\n",
        "\"\"\"\n",
        "\n",
        "# Define tools with precise descriptions\n",
        "tools = [\n",
        "    Tool(\n",
        "        name=\"rag_search\",\n",
        "        func=rag_search,\n",
        "        description=(\n",
        "            \"Search the research knowledge base using semantic similarity. \"\n",
        "            \"Use this tool when the question is specific and likely covered in \"\n",
        "            \"the indexed documents (Transformers, RAG, AI Agents). \"\n",
        "            \"Input: a natural language question string.\"\n",
        "        )\n",
        "    ),\n",
        "    Tool(\n",
        "        name=\"summarize_topic\",\n",
        "        func=summarize_topic,\n",
        "        description=(\n",
        "            \"Generate a bullet-point summary of a broad research topic using \"\n",
        "            \"the LLM's own knowledge. Use this for general or introductory \"\n",
        "            \"questions not tied to specific documents. \"\n",
        "            \"Input: a topic name or concept string.\"\n",
        "        )\n",
        "    ),\n",
        "    Tool(\n",
        "        name=\"inspect_knowledge_base\",\n",
        "        func=inspect_knowledge_base,\n",
        "        description=(\n",
        "            \"Inspect the research knowledge base to see what topics and documents \"\n",
        "            \"are available. Use when the user asks what you know, how many documents \"\n",
        "            \"are loaded, or which topics are covered. Input: any string (ignored).\"\n",
        "        )\n",
        "    ),\n",
        "]\n",
        "\n",
        "# Load the ReAct prompt template from LangChain Hub\n",
        "react_prompt = hub.pull(\"hwchase17/react\")\n",
        "\n",
        "# Assemble the ReAct agent\n",
        "react_agent = create_react_agent(\n",
        "    llm=llm,\n",
        "    tools=tools,\n",
        "    prompt=react_prompt\n",
        ")\n",
        "\n",
        "# Wrap in AgentExecutor (handles the reasoning loop)\n",
        "agent_executor = AgentExecutor(\n",
        "    agent=react_agent,\n",
        "    tools=tools,\n",
        "    verbose=True,          # Prints Thought / Action / Observation trace\n",
        "    max_iterations=6,      # Prevents infinite loops\n",
        "    handle_parsing_errors=True,\n",
        "    return_intermediate_steps=True\n",
        ")\n",
        "\n",
        "print(\" ReAct agent assembled with\", len(tools), \"tools.\")"
      ]
    },
