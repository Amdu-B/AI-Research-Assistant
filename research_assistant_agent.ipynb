      "source": [
        "---\n",
        "## Section 3 🤖 Groq LLM Setup (LLaMA 3)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "id": "llm-cell",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "llm-cell",
        "outputId": "4bb3b468-8fde-45d8-cc60-b37a8133dffb"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "🦙 LLM check: LLaMA 3 ready.\n"
          ]
        }
      ],
      "source": [
        "\"\"\"\n",
        "Groq LLM Initialisation\n",
        "========================\n",
        "Groq's Language Processing Unit (LPU) delivers industry-leading\n",
        "inference speeds (~800 tokens/sec for LLaMA 3 70B), making it ideal\n",
        "for agentic loops that require multiple rapid LLM calls.\n",
        "\n",
        "Two model variants:\n",
        "  - llama3-70b-8192 : highest quality, 8K context window\n",
        "  - llama3-8b-8192  : fastest, suitable for lighter tasks\n",
        "\"\"\"\n",
        "\n",
        "def create_llm(api_key: str, model: str = LLM_MODEL, temperature: float = TEMPERATURE) -> ChatGroq:\n",
        "    \"\"\"\n",
        "    Initialise a ChatGroq LLM instance.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    api_key     : str   - Groq API key.\n",
        "    model       : str   - Groq model identifier.\n",
        "    temperature : float - Sampling temperature (0 = deterministic, 1 = creative).\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    ChatGroq\n",
        "        Configured LangChain-compatible LLM.\n",
        "    \"\"\"\n",
        "    llm = ChatGroq(\n",
        "        groq_api_key=api_key,\n",
        "        model_name=model,\n",
        "        temperature=temperature,\n",
        "        max_tokens=1024,\n",
        "    )\n",
        "    return llm\n",
        "\n",
        "\n",
        "llm = create_llm(GROQ_API_KEY)\n",
        "\n",
        "# Quick sanity check\n",
        "test_response = llm.invoke(\"Reply with exactly: 'LLaMA 3 ready.'\")\n",
        "print(f\"🦙 LLM check: {test_response.content}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "section4-md",
      "metadata": {
        "id": "section4-md"
      },
      "source": [
        "## Section 4  🛠️ Agent Tools\n",
        "\n",
        "The agent has access to three tools. The quality of each tool's *description* is critical —\n",
        "the LLM reads these descriptions to decide which tool to invoke."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 12,
      "id": "rag-tool-cell",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "rag-tool-cell",
        "outputId": "27000b59-d8a0-4973-b57c-691cb70d4ae5"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            " Tool 1 (RAG Search) ready.\n"
          ]
        }
      ],
      "source": [
        "\"\"\"\n",
        "Tool 1: RAG Search\n",
        "==================\n",
        "Performs semantic retrieval over the ingested research documents.\n",
        "Returns the top-k most relevant chunks concatenated with their source\n",
        "metadata, then passes them through an LLM to produce a grounded answer.\n",
        "\"\"\"\n",
        "\n",
        "# Custom RAG prompt — instructs LLM to stay grounded in retrieved context\n",
        "RAG_PROMPT_TEMPLATE = PromptTemplate(\n",
        "    input_variables=[\"context\", \"question\"],\n",
        "    template=\"\"\"\n",
        "You are an expert AI research assistant. Answer the question ONLY using the context below.\n",
        "If the context does not contain enough information, say \"The documents don't cover this topic.\"\n",
        "Always cite the source filename at the end of your answer.\n",
        "\n",
        "Context:\n",
        "{context}\n",
        "\n",
        "Question: {question}\n",
        "\n",
        "Answer (with source citation):\"\"\"\n",
        ")\n",
        "\n",
        "# Build the RAG chain\n",
        "rag_chain = RetrievalQA.from_chain_type(\n",
        "    llm=llm,\n",
        "    chain_type=\"stuff\",             # 'stuff' = concatenate all chunks into one prompt\n",
        "    retriever=retriever,\n",
        "    return_source_documents=True,\n",
        "    chain_type_kwargs={\"prompt\": RAG_PROMPT_TEMPLATE}\n",
        ")\n",
        "\n",
        "\n",
        "def rag_search(query: str) -> str:\n",
        "    \"\"\"\n",
        "    Search the research knowledge base using RAG.\n",
        "\n",
        "    Embeds the query, retrieves the top-k most similar document chunks\n",
        "    from FAISS, and generates a grounded answer using LLaMA 3.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    query : str\n",
        "        Natural language question about a research topic.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    str\n",
        "        LLM-generated answer grounded in retrieved document chunks.\n",
        "    \"\"\"\n",
        "    result = rag_chain.invoke({\"query\": query})\n",
        "    answer = result[\"result\"]\n",
        "    sources = list({doc.metadata.get(\"source\", \"unknown\") for doc in result[\"source_documents\"]})\n",
        "    return f\"{answer}\\n\\n📖 Sources: {', '.join(sources)}\"\n",
        "\n",
        "\n",
        "print(\" Tool 1 (RAG Search) ready.\")"
      ]
    },
