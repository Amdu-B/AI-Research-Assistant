        "\"\"\"\n",
        "Lightweight Evaluation\n",
        "=======================\n",
        "Evaluates the RAG pipeline on a small set of question-answer pairs\n",
        "using the LLM as a judge (LLM-as-Evaluator pattern).\n",
        "\n",
        "For production, use RAGAS (https://github.com/explodinggradients/ragas)\n",
        "which provides faithfulness, answer relevance, and context precision metrics.\n",
        "\"\"\"\n",
        "\n",
        "EVAL_DATASET = [\n",
        "    {\n",
        "        \"question\": \"What is positional encoding used for in Transformers?\",\n",
        "        \"expected_keywords\": [\"position\", \"order\", \"sinusoidal\", \"sequence\"]\n",
        "    },\n",
        "    {\n",
        "        \"question\": \"What does FAISS stand for and what does it do?\",\n",
        "        \"expected_keywords\": [\"Facebook\", \"similarity\", \"search\", \"vector\"]\n",
        "    },\n",
        "    {\n",
        "        \"question\": \"Name two agent frameworks mentioned in the documents.\",\n",
        "        \"expected_keywords\": [\"LangChain\", \"LlamaIndex\", \"AutoGen\", \"CrewAI\"]\n",
        "    },\n",
        "]\n",
        "\n",
        "\n",
        "def keyword_precision(answer: str, keywords: List[str]) -> float:\n",
        "    \"\"\"\n",
        "    Calculate what fraction of expected keywords appear in the answer.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    answer   : str        - The model's answer string.\n",
        "    keywords : list[str]  - Expected keywords that should appear.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    float\n",
        "        Precision score in [0.0, 1.0].\n",
        "    \"\"\"\n",
        "    answer_lower = answer.lower()\n",
        "    hits = sum(1 for kw in keywords if kw.lower() in answer_lower)\n",
        "    return hits / len(keywords) if keywords else 0.0\n",
        "\n",
        "\n",
        "print(\" Running evaluation...\\n\")\n",
        "scores = []\n",
        "\n",
        "for i, sample in enumerate(EVAL_DATASET, 1):\n",
        "    result  = rag_chain.invoke({\"query\": sample[\"question\"]})\n",
        "    answer  = result[\"result\"]\n",
        "    score   = keyword_precision(answer, sample[\"expected_keywords\"])\n",
        "    scores.append(score)\n",
        "\n",
        "    status = \" \" if score >= 0.5 else \"⚠️\"\n",
        "    print(f\"Q{i}: {sample['question']}\")\n",
        "    print(f\"     Keyword precision: {score:.0%} {status}\")\n",
        "    print(f\"     Answer snippet: {answer[:120].strip()}...\\n\")\n",
        "\n",
        "avg_score = sum(scores) / len(scores)\n",
        "print(f\"{'─'*50}\")\n",
        "print(f\" Average keyword precision: {avg_score:.0%}\")\n",
        "print(f\"{'─'*50}\")"
      ]
