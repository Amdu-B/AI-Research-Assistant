      "source": [
        "\"\"\"\n",
        "HuggingFace Embeddings + FAISS Vector Store\n",
        "============================================\n",
        "all-MiniLM-L6-v2 is a lightweight sentence transformer (22M params)\n",
        "that produces 384-dimensional embeddings. It achieves a strong\n",
        "speed/quality trade-off, making it ideal for local or serverless use.\n",
        "\n",
        "FAISS (Facebook AI Similarity Search) stores these vectors and\n",
        "supports sub-millisecond approximate nearest-neighbour search\n",
        "even over millions of vectors.\n",
        "\"\"\"\n",
        "\n",
        "def build_vector_store(chunks: List[Document]) -> FAISS:\n",
        "    \"\"\"\n",
        "    Embed document chunks and store them in a FAISS index.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    chunks : list of Document\n",
        "        Pre-processed, chunked documents.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    FAISS\n",
        "        A searchable vector store.\n",
        "    \"\"\"\n",
        "    print(\"⚙️  Loading HuggingFace embedding model (first run downloads ~90 MB)...\")\n",
        "    embeddings = HuggingFaceEmbeddings(\n",
        "        model_name=EMBEDDING_MODEL,\n",
        "        model_kwargs={\"device\": \"cpu\"},   # Change to 'cuda' if GPU available\n",
        "        encode_kwargs={\"normalize_embeddings\": True}  # Cosine similarity\n",
        "    )\n",
        "\n",
        "    print(\"📐 Building FAISS index...\")\n",
        "    vector_store = FAISS.from_documents(chunks, embeddings)\n",
        "    return vector_store\n",
        "\n",
        "\n",
        "vector_store = build_vector_store(document_chunks)\n",
        "retriever    = vector_store.as_retriever(search_kwargs={\"k\": TOP_K_RETRIEVAL})\n",
        "\n",
        "print(f\"\\n FAISS index built │ {len(document_chunks)} vectors │ top-{TOP_K_RETRIEVAL} retrieval\")"
      ]
    },
