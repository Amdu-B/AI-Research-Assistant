        "Retrieval Inspection\n",
        "====================\n",
        "Visualises which document chunks are retrieved for a given query.\n",
        "Useful for debugging poor answers — if retrieval is wrong, the\n",
        "answer will be wrong regardless of the LLM quality.\n",
        "\"\"\"\n",
        "\n",
        "def inspect_retrieval(query: str, k: int = 3) -> None:\n",
        "    \"\"\"\n",
        "    Print the top-k retrieved chunks for a given query.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    query : str  - The search query.\n",
        "    k     : int  - Number of chunks to retrieve and display.\n",
        "    \"\"\"\n",
        "    retriever_k = vector_store.as_retriever(search_kwargs={\"k\": k})\n",
        "    docs        = retriever_k.invoke(query)\n",
        "\n",
        "    print(f\"\\n Top-{k} retrieved chunks for: '{query}'\\n\")\n",
        "    for rank, doc in enumerate(docs, 1):\n",
        "        src   = doc.metadata.get(\"source\", \"unknown\")\n",
        "        topic = doc.metadata.get(\"topic\", \"unknown\")\n",
        "        print(f\"  [{rank}] Source: {src} | Topic: {topic}\")\n",
        "        print(f\"       {doc.page_content[:200].strip()}...\")\n",
        "        print()\n",
        "\n",
        "\n",
        "inspect_retrieval(\"How does self-attention work in neural networks?\")"
