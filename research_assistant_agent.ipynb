      "source": [
        "\"\"\"\n",
        "Document Chunking\n",
        "=================\n",
        "RecursiveCharacterTextSplitter splits text hierarchically:\n",
        "  paragraph → sentence → word → character\n",
        "This produces semantically coherent chunks rather than arbitrary cuts.\n",
        "\n",
        "chunk_overlap ensures that sentences straddling a boundary appear\n",
        "in both neighbouring chunks, preventing information loss at edges.\n",
        "\"\"\"\n",
        "\n",
        "def ingest_documents(raw_docs: List[Dict[str, Any]]) -> List[Document]:\n",
        "    \"\"\"\n",
        "    Convert raw document dicts into chunked LangChain Document objects.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    raw_docs : list of dict\n",
        "        Each dict must have 'content' (str) and 'metadata' (dict) keys.\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    list of Document\n",
        "        Chunked documents ready for embedding.\n",
        "    \"\"\"\n",
        "    splitter = RecursiveCharacterTextSplitter(\n",
        "        chunk_size=CHUNK_SIZE,\n",
        "        chunk_overlap=CHUNK_OVERLAP,\n",
        "        separators=[\"\\n\\n\", \"\\n\", \".\", \" \", \"\"]\n",
        "    )\n",
        "\n",
        "    all_chunks: List[Document] = []\n",
        "    for doc in raw_docs:\n",
        "        chunks = splitter.create_documents(\n",
        "            texts=[doc[\"content\"]],\n",
        "            metadatas=[doc[\"metadata\"]]\n",
        "        )\n",
        "        all_chunks.extend(chunks)\n",
        "        print(f\"  📄 '{doc['metadata']['source']}' → {len(chunks)} chunks\")\n",
        "\n",
        "    return all_chunks\n",
        "\n",
        "\n",
        "print(\"🔪 Chunking documents...\")\n",
        "document_chunks = ingest_documents(SAMPLE_DOCUMENTS)\n",
        "print(f\"\\n Total chunks created: {len(document_chunks)}\")"
      ]
    },
